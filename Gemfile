source 'https://rubygems.org'
group :jekyll_plugins do
    gem 'jekyll'
    gem 'jekyll-archives'
    gem 'jekyll-email-protect'
    gem 'jekyll-feed'
    gem 'jekyll-imagemagick'
    gem 'jekyll-link-attributes'
    gem 'jekyll-minifier'
    gem 'jekyll-paginate-v2'
    gem 'jekyll-regex-replace'
    gem 'jekyll-scholar'
    gem 'jekyll-sitemap'
    gem 'terser'
    gem 'webrick'
end
group :other_plugins do
    gem 'base64' # no longer a default gem in newer Ruby versions
    gem 'csv' # no longer a default gem in newer Ruby versions
    gem 'logger' # no longer a default gem in newer Ruby versions
    gem 'nokogiri' # used by jekyll-link-attributes
    gem 'observer' # used by jekyll-scholar
end
