<!-- Metadata, OpenGraph and Schema.org -->
{% include metadata.liquid %}

<!-- Fonts, loaded without blocking the first render (text uses a fallback font until they arrive) -->
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="{{ site.third_party_libraries.google_fonts.url.fonts }}"
  media="print"
  onload="this.media='all'"
>
<noscript><link rel="stylesheet" href="{{ site.third_party_libraries.google_fonts.url.fonts }}"></noscript>

{% if site.icon.size <= 4 %}
  <link
    rel="shortcut icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
  >
{% elsif site.icon != blank %}
  <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache}}">
{% endif %}
<!--
  Styles: Bootstrap, MDB, icons and code highlighting are all compiled into main.css,
  which the deploy workflow inlines into each page after purging (bin/inline-css.js)
-->
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
{% if page.layout == 'about' and page.profile.image and site.imagemagick.enabled %}
  {% assign profile_ext = page.profile.image | split: '.' | last %}
  {% if profile_ext == 'gif' or profile_ext == 'jpeg' or profile_ext == 'jpg' or profile_ext == 'png' or profile_ext == 'tiff' %}
    <!-- Preload the profile photo (the LCP element on the about page) so it starts downloading before the body is parsed -->
    {% assign profile_img_path = page.profile.image
      | prepend: 'assets/img/'
      | remove: '.jpg'
      | remove: '.jpeg'
      | remove: '.png'
      | remove: '.tiff'
      | remove: '.gif'
    %}
    <link
      rel="preload"
      as="image"
      type="image/webp"
      imagesrcset="{% for i in site.imagemagick.widths %}{{ profile_img_path | relative_url }}-{{ i }}.webp {{ i }}w,{% endfor %}"
      imagesizes="(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"
      fetchpriority="high"
    >
  {% endif %}
{% endif %}
<link rel="canonical" href="{{ page.url | replace:'index.html','' | absolute_url }}">

<!-- Dark Mode -->
<script>
  {% include theme.js %}
  {% if site.enable_darkmode %}
    initTheme();
  {% endif %}
</script>
